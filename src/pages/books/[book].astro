---
import type { IBook } from "../../types/book";

import BookLayout from "../../layouts/BookLayout.astro";
import { BooksService } from "../../lib/services/books";
import { convertMmtoCm, convertWeightToKg } from "../../utils/utils";

export async function getStaticPaths() {
    const { data: books, error } = await BooksService.getForStaticPaths();

    if (error) {
        console.error("Error fetching books:", error);
        return [];
    }

    return books?.map((book) => ({
        params: { book: book.slug },
        props: { bookId: book.id },
    }));
}

interface Props {
    bookId: string;
}

const { bookId } = Astro.props;

const { data: book, error } = await BooksService.getByIdWithReviews(bookId);

if (error || !book) {
    console.error("Error fetching book:", error);
    return Astro.redirect("/404");
}

const bookData: IBook = {
    id: book.id,
    sku: book.sku,
    title: book.title,
    destination: book.destination,
    description: book.description,
    excerpt: book.excerpt,
    chapters: book.chapters,
    price: book.price,
    discount: book.discount ?? 0,
    quantity: book.quantity,
    image: {
        url: book.cover_image || "/images/default-book.jpg",
        alt: `${book.title} cover`,
    },
    tags: book.tags || [],
    parameters: {
        weight: book.weight_g
            ? `${convertWeightToKg(book.weight_g)} kg`
            : "N/A",
        dimensions:
            book.width_mm && book.height_mm && book.length_mm
                ? `${convertMmtoCm(book.width_mm)} × ${convertMmtoCm(book.height_mm)} × ${convertMmtoCm(book.length_mm)} cm`
                : "N/A",
    },
    rating: book.rating || 0,
    book_reviews: book.book_reviews,
    review_count: book.review_count || 0,
};
---

<BookLayout book={bookData} />
