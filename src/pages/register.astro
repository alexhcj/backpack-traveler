---
export const prerender = false;

import { actions } from "astro:actions";
import RegisterLayout from "../layouts/RegisterLayout.astro";

const result = Astro.getActionResult(actions.auth.register);
if (result?.data) return Astro.redirect(result.data.next);
if (Astro.locals.user) return Astro.redirect("/account");
---

<RegisterLayout />
