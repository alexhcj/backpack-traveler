---
import BaseLayout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Notice from "../components/Notice.astro";
import CheckoutForm from "../components/Checkout/CheckoutForm.astro";
import { EFooter } from "../types/footer";
import { EHeader } from "../types/header";
import type { TCart } from "../types/cart";

interface Props {
    cart: TCart;
    values: Record<string, string>;
    errors: Record<string, string | undefined>;
    error?: string;
}

const { cart, values, errors, error } = Astro.props;
---

<BaseLayout
    title="Backpack Traveler – Checkout"
    headerType={EHeader.FULL}
    footerType={EFooter.FULL}
    fixedHeader
>
    <Breadcrumbs narrow />
    <section class="section">
        <div class="container narrow">
            <div class="box">
                {error && <Notice type="error">{error}</Notice>}
                <Notice action={{ href: "/cart", label: "Enter code" }}>
                    Have a coupon?
                </Notice>
                <CheckoutForm cart={cart} values={values} errors={errors} />
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .box {
        padding: 50px 0 90px;
    }
</style>
