---
import { actions } from "astro:actions";
import ShoppingBagSVG from "../../../../public/svg/shopping-bag.svg";
import CloseSVG from "../../../../public/svg/close.svg";
import { CartService } from "../../../lib/services/cart";
import { formatPrice } from "../../../utils/utils";

// Server island: rendered per request from the visitor's cart.
const { data: cart } = await CartService.get(
    Astro.locals.supabase,
    Astro.locals.cartSessionId,
);
const items = cart?.items ?? [];
---

<div class="cart" data-cart>
    <ShoppingBagSVG class="icon cart-icon" />
    <span class="badge" data-cart-count>{cart?.count ?? 0}</span>
    <div class="dropdown">
        <div class="box" data-cart-box hidden={items.length === 0}>
            <ul class="list" data-cart-list>
                {
                    items.map((item) => (
                        <li class="card" data-item-id={item.id}>
                            <a href={`/books/${item.slug}`}>
                                <img
                                    class="item-img"
                                    src={`/books/${item.cover_image}`}
                                    width={84}
                                    height={84}
                                    alt=""
                                />
                            </a>
                            <div class="details">
                                <h6 class="title">
                                    <a class="link" href={`/books/${item.slug}`}>
                                        {item.title}
                                    </a>
                                </h6>
                                <div class="price">
                                    <span>{item.quantity}</span>
                                    <span>x</span>
                                    <span>${formatPrice(item.unit_price)}</span>
                                </div>
                            </div>
                            <button
                                class="button-remove"
                                type="button"
                                aria-label={`Remove ${item.title}`}
                            >
                                <CloseSVG class="icon-close" />
                            </button>
                        </li>
                    ))
                }
            </ul>
            <div class="bottom">
                <div class="total">
                    <span>Total:</span>
                    <span data-cart-total>${formatPrice(cart?.subtotal ?? 0)}</span>
                </div>
                <div class="actions">
                    <a class="ui-button-primary alt" href="/cart">View cart</a>
                    <a class="ui-button-primary" href="/checkout">Checkout</a>
                </div>
            </div>
        </div>
        <div class="empty" data-cart-empty hidden={items.length > 0}>
            <span>No products in the cart.</span>
        </div>
    </div>
</div>

<template data-cart-item-template>
    <li class="card">
        <a data-link-img href="/"><img class="item-img" width="84" height="84" alt="" /></a>
        <div class="details">
            <h6 class="title"><a class="link" data-link href="/"></a></h6>
            <div class="price"><span data-qty></span><span>x</span><span data-price></span></div>
        </div>
        <button class="button-remove" type="button" aria-label="Remove"><CloseSVG class="icon-close" /></button>
    </li>
</template>

<style>
    .cart {
        position: relative;
        margin-left: 11px;

        &:hover {
            .dropdown {
                top: calc(100% + 38px);
                opacity: 1;
                visibility: visible;
            }
        }
    }

    .icon {
        display: flex;
        cursor: pointer;

        path {
            fill: var(--color-grey-2);
            transition: var(--transition-default);
        }
    }

    .cart-icon {
        width: 23px;
        height: 23px;
        translate: 0 -2px;
    }

    .badge {
        position: absolute;
        top: -2px;
        right: -4px;
        width: 12px;
        height: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 12px;
        font-size: 9px;
        border-radius: 50%;
        background-color: var(--color-accent);
        color: var(--color-white);
    }

    .dropdown {
        position: absolute;
        top: calc(100% + 70px);
        left: auto;
        right: -18px;
        padding: 20px 17px 15px 17px;
        width: 240px;
        background-color: var(--color-white);
        border: 1px solid #f3f3f3;
        text-align: left;
        z-index: var(--z-index-30);
        opacity: 0;
        visibility: hidden;
        box-sizing: border-box;
        transition: var(--transition-dropdown);
    }

    .empty {
        font-size: 12px;
        font-family: var(--family-lora);
        font-style: italic;
    }

    .list {
        padding-bottom: 3px;
    }

    .card {
        position: relative;
        display: grid;
        grid-template-columns: 84px 1fr;
    }

    .title {
        margin: 0;
        padding: 0 15px 5px 0;
    }

    .button-remove {
        padding: 0;
        border: 0;
        background: none;
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        width: 14px;
        height: 14px;
        cursor: pointer;

        &:hover {
            .icon-close path {
                fill: var(--color-black);
            }
        }
    }

    .icon-close {
        width: 13px;
        height: 13px;

        path {
            fill: var(--color-accent);
            transition: var(--transition-default);
        }
    }

    .price {
        display: flex;
        gap: 5px;
        margin-top: 2px;
        font-size: 12px;
        font-family: var(--family-lora);
        font-style: italic;
    }

    .bottom {
        padding-top: 10px;
        border-top: 1px solid #f3f3f3;
    }

    .total {
        display: flex;
        justify-content: space-between;
        width: 100%;
        margin-bottom: 11px;

        span {
            line-height: 20px;
        }

        span:first-child {
            text-transform: uppercase;
            letter-spacing: var(--letter-spacing-m);
            font-size: 12px;
        }

        span:last-child {
            font-size: 14px;
            font-family: var(--family-lora);
            font-style: italic;
        }
    }

    .actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ui-button-primary {
        padding: 9px 14px 8px;
        font-size: 8px;
    }
</style>

<script>
    import { actions } from "astro:actions";
    import type { TCart } from "../../../types/cart";

    const money = (n: number) => `$${n.toFixed(2)}`;

    function render(root: HTMLElement, cart: TCart) {
        const list = root.querySelector<HTMLElement>("[data-cart-list]")!;
        const tpl = root.parentElement!.querySelector<HTMLTemplateElement>(
            "[data-cart-item-template]",
        )!;

        list.replaceChildren(
            ...cart.items.map((item) => {
                const li = (tpl.content.cloneNode(true) as DocumentFragment)
                    .firstElementChild as HTMLElement;
                li.dataset.itemId = item.id;
                li.querySelectorAll<HTMLAnchorElement>("a").forEach(
                    (a) => (a.href = `/books/${item.slug}`),
                );
                li.querySelector<HTMLAnchorElement>("[data-link]")!.textContent = item.title;
                const img = li.querySelector("img")!;
                img.src = `/books/${item.cover_image}`;
                li.querySelector("[data-qty]")!.textContent = String(item.quantity);
                li.querySelector("[data-price]")!.textContent = money(item.unit_price);
                li.querySelector("button")!.setAttribute("aria-label", `Remove ${item.title}`);
                return li;
            }),
        );
        root.querySelector("[data-cart-count]")!.textContent = String(cart.count);
        root.querySelector("[data-cart-total]")!.textContent = money(cart.subtotal);
        root.querySelector<HTMLElement>("[data-cart-box]")!.hidden = cart.items.length === 0;
        root.querySelector<HTMLElement>("[data-cart-empty]")!.hidden = cart.items.length > 0;
    }

    window.addEventListener("cart:updated", (e) => {
        const root = document.querySelector<HTMLElement>("[data-cart]");
        if (root) render(root, (e as CustomEvent<TCart>).detail);
    });

    // Event delegation: items are re-rendered from JSON
    document.addEventListener("click", async (e) => {
        const button = (e.target as HTMLElement).closest<HTMLButtonElement>(
            "[data-cart] .button-remove",
        );
        if (!button) return;
        const itemId = button.closest<HTMLElement>("[data-item-id]")?.dataset.itemId;
        if (!itemId) return;

        button.disabled = true;
        const form = new FormData();
        form.set("itemId", itemId);
        const { data } = await actions.cart.remove(form);
        if (data) window.dispatchEvent(new CustomEvent("cart:updated", { detail: data }));
        else button.disabled = false;
    });
</script>
