---
import ShoppingBagSVG from "../../../../public/svg/shopping-bag.svg";
---

<!-- Shown while the <HeaderCart server:defer> island loads -->
<div class="cart">
    <ShoppingBagSVG class="icon cart-icon" />
    <span class="badge">0</span>
</div>

<style>
    .cart {
        position: relative;
        margin-left: 11px;
    }

    .icon {
        display: flex;
        cursor: pointer;

        path {
            fill: var(--color-grey-2);
        }
    }

    .cart-icon {
        width: 23px;
        height: 23px;
        translate: 0 -2px;
    }

    .badge {
        position: absolute;
        top: -2px;
        right: -4px;
        width: 12px;
        height: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 12px;
        font-size: 9px;
        border-radius: 50%;
        background-color: var(--color-accent);
        color: var(--color-white);
    }
</style>
