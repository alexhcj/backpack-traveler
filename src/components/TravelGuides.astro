---
import { Image } from "astro:assets";
import { BooksService } from "../lib/services/books";
import { calcDiscountPrice, isBookNew } from "../utils/utils";

interface Props {
    title?: string;
    subTitle?: string;
    /** book slugs, in display order */
    booksList: string[];
}

const {
    booksList,
    title = "My travel guides",
    subTitle = "We are That Backpacker, Melissa and Johnatan (that’s us!)",
} = Astro.props;

const { data: books } = await BooksService.getBySlugs(booksList);

const booksToShow = (books ?? []).map((book) => ({
    slug: book.slug,
    title: book.title,
    image: `/books/${book.cover_image}`,
    price: book.price,
    discount: book.discount,
    discountPrice: book.discount
        ? calcDiscountPrice(book.price, book.discount)
        : null,
    tag: book.discount
        ? "Sale"
        : isBookNew(book.published_date ?? book.created_at ?? "")
          ? "New"
          : "",
}));
---

<section class="ui-post-guides">
    <div class="container">
        <h3 class="ui-post-title">{title}</h3>
        <p class="ui-post-guides-subtitle">
            {subTitle}
        </p>
        <ul class="ui-post-guides-list">
            {
                booksToShow.map(
                    ({
                        image,
                        title,
                        slug,
                        tag,
                        price,
                        discount,
                        discountPrice,
                    }) => (
                        <li class="ui-post-guides-list-item">
                            <a class="link" href={`/books/${slug}`}>
                                <span class="ui-post-guides-list-item-tag">
                                    {tag}
                                </span>
                                <Image
                                    class="ui-post-guides-list-item-image"
                                    src={image}
                                    width={220}
                                    height={270}
                                    alt={`${title} cover`}
                                />
                                <div class="ui-post-guides-list-item-sell">
                                    Buy for
                                    <span
                                        class={`ui-post-guides-list-item-price ${discount && "discount"}`}
                                    >
                                        ${price.toFixed(2)}
                                    </span>
                                    {discountPrice && (
                                        <span class="ui-post-guides-list-item-discount">
                                            - ${discountPrice}
                                        </span>
                                    )}
                                </div>
                            </a>
                        </li>
                    ),
                )
            }
        </ul>
    </div>
</section>

<style>
    .ui-post-guides {
        margin: 0;
        padding: 100px 0;
    }
    .ui-post-guides-subtitle {
        margin-top: 13px;
        line-height: 34px;
    }
    .ui-post-guides-list {
        grid-template: auto / repeat(6, 1fr);
        margin-top: 78px;
    }
    .link {
        display: block;
    }
    .ui-post-guides-list-item-image {
        width: 100%;
        object-fit: cover;
    }
    .ui-post-guides-list-item-sell {
        bottom: 95px;
    }
</style>
