---
import { actions } from "astro:actions";
import AddToCartButton from "./Cart/AddToCartButton.astro";
import QuantityField from "./QuantityField.astro";

interface Props {
    bookId: string;
    title?: string;
    initialQuantity?: number;
    min?: number;
    max?: number;
    availableStock?: number;
}

const {
    bookId,
    title,
    initialQuantity = 1,
    min = 1,
    max,
    availableStock,
} = Astro.props;

const maxQuantity = max ?? availableStock ?? 99;
---

<form
    class="form"
    method="POST"
    action={"/cart" + actions.cart.add}
    data-title={title}
    data-add-to-cart
    data-book-id={bookId}
>
    <input type="hidden" name="bookId" value={bookId} />

    <QuantityField
        id={`quantity-${bookId}`}
        value={initialQuantity}
        min={min}
        max={maxQuantity}
    />

    <AddToCartButton variant="button" soldOut={availableStock === 0} />
</form>

{
    availableStock !== undefined &&
        availableStock > 0 &&
        availableStock < 10 && (
            <p class="stock-warning">Only {availableStock} left in stock</p>
        )
}

<style>
    .form {
        display: flex;
        align-items: center;
    }

    .stock-warning {
        margin-top: 8px;
        font-size: 12px;
        color: var(--color-warning);
    }
</style>
