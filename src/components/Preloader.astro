---
interface Props {
    size?: number;
    class?: string;
}

const { size = 16, class: className } = Astro.props;
---

<!-- Circle preloader. Color: `--preloader-color` (defaults to --color-accent) -->
<svg
    class:list={["preloader", className]}
    width={size}
    height={size}
    viewBox="0 0 16 16"
    fill="none"
    role="presentation"
    aria-hidden="true"
>
    <circle class="track" cx="8" cy="8" r="7" stroke-width="2"></circle>
    <path class="arc" d="M8 1a7 7 0 0 1 7 7" stroke-width="2" stroke-linecap="round"></path>
</svg>

<style>
    .preloader {
        flex: none;
        animation: preloader-spin 0.8s linear infinite;
    }

    .track {
        stroke: var(--preloader-color, var(--color-accent));
        opacity: 0.25;
    }

    .arc {
        stroke: var(--preloader-color, var(--color-accent));
    }

    @keyframes preloader-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .preloader {
            animation-duration: 2s;
        }
    }
</style>
