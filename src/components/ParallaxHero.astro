---
import { Image } from "astro:assets";

interface Props {
    title: string;
    src: string;
    alt: string;
}

const { title, src, alt } = Astro.props;
---

<!--
  Parallax hero (Figma: "Hero banner"). The box and the image are both exactly
  300px tall. The image (1920x600, cropped by object-fit: cover) is panned from
  its bottom edge to its top edge while the page scrolls the first 300px, which
  reads as ~0.5x scroll speed. The title does not move. Pure CSS
  (scroll-driven animation); browsers without support show the static image.
-->
<section class="hero">
    <Image class="img" src={src} width={1920} height={600} alt={alt} />
    <h1 class="title">{title}</h1>
</section>

<style>
    .hero {
        position: relative;
        height: 300px;
        overflow: hidden;
    }

    .img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 300px;
        object-fit: cover;
        object-position: 50% 100%;
    }

    .title {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        margin: 0;
        color: var(--color-white);
    }

    @supports (animation-timeline: scroll()) {
        @media (prefers-reduced-motion: no-preference) {
            .img {
                animation: hero-parallax linear both;
                animation-timeline: scroll(root block);
                animation-range: 0 300px;
            }
        }
    }

    @keyframes hero-parallax {
        from {
            object-position: 50% 100%;
        }
        to {
            object-position: 50% 0%;
        }
    }
</style>
